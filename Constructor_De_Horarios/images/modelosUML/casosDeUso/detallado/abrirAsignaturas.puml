@startuml

skinparam shadowing false
skinparam state {
    BackgroundColor #F5F5F5
    BorderColor #444
    FontSize 12
}

state "abrirAsignaturas()" as abrirAsig {
    [*] --> EstadoInicial
    EstadoInicial --> ListaPresentada : Administrador solicita abrir asignaturas
    
    note on Link
        **Sistema** presenta lista de asignaturas
        • Código, nombre, créditos, curso de cada asignatura
        • Permite solicitar filtrar lista
        • Permite solicitar crear asignatura nueva
        • Permite solicitar eliminar asignatura
        • Permite solicitar editar asignatura
    end note
    
    ListaPresentada --> ListaPresentada : Administrador solicita filtrar lista\n**Sistema** presenta lista filtrada
    ListaPresentada --> EstadoFinal : Administrador solicita una de las opciones
    EstadoFinal --> [*]
}

abrirAsig --> ASIGNATURA_ABIERTA : crearAsignatura() / editarAsignatura()
abrirAsig --> ASIGNATURAS_ABIERTO : eliminarAsignatura()
abrirAsig --> SISTEMA_DISPONIBLE : completarGestion()

@enduml