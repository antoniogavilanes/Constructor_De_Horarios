@startuml

hide empty description

[*] --> ConsultarGrados
note on link
    Usuario accede a la lista de grados disponibles
end note

state ConsultarGrados {
    [*] --> MostrarListaGrados
    note right
      El sistema despliega todos los grados académicos
    end note
    MostrarListaGrados --> SeleccionarGrado
    note on link
      Usuario selecciona un grado para ver horarios
    end note
}

SeleccionarGrado --> ConsultarHorarios
note on link
    Usuario quiere revisar horarios del grado seleccionado
end note

state ConsultarHorarios {
    [*] --> MostrarHorarios
    note right
      El sistema muestra los horarios asociados al grado
    end note
    MostrarHorarios --> [*]
}

ConsultarHorarios --> GestionarAsignaturas
note on link
    Usuario inicia edición o asignación de materias
end note

state GestionarAsignaturas {
    [*] --> InterfazArrastrarSoltar
    note right
      Usuario asigna o reasigna materias mediante drag & drop
    end note
    InterfazArrastrarSoltar --> ValidarAsignacion
    note on link
      Sistema valida conflictos y asignaciones
    end note
    ValidarAsignacion --> MostrarAlerta
    note left
      En caso de conflicto, alerta al usuario
    end note
    ValidarAsignacion --> [*]
    MostrarAlerta --> [*]
}

@enduml
